          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "finance_dashboard_2026": {
      ".read": true,
      "transactions": {
        "$recordId": {
          ".write": "$recordId.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['cardId', 'recordType', 'status', 'amount', 'date', 'merchant'])",
          "cardId": {
            ".validate": "newData.isString() && newData.val().matches(/^(shinhan|naver|hyundai_mine|hyundai_mom|samsung|kbank)$/)"
          },
          "recordType": {
            ".validate": "newData.isString() && newData.val().matches(/^(transaction|statement|scheduled_debit|cashback)$/)"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(approved|cancelled|confirmed|scheduled)$/)"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() >= -50000000 && newData.val() <= 50000000"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "merchant": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "billingCycle": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^20[0-9]{2}-[01][0-9]-10$/))"
          },
          "owner": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(mine|mom)$/))"
          },
          "questionRequired": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "resolved": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "affectsBill": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000)"
          },
          "updatedAt": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000)"
          },
          "detail": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
          }
        }
      },
      "updates": {
        "$updateId": {
          ".write": "$updateId.matches(/^-?[A-Za-z0-9_]{1,100}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['text', 'signature', 'status', 'createdAt', 'updatedAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "signature": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(pending|processing|processed|needs_info|error)$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "processedAt": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000)"
          },
          "result": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 500)"
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
