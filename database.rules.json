{
  "rules": {
    ".read": "now < 1784646000000",  // 2026-7-22
    ".write": "now < 1784646000000",  // 2026-7-22
    "2026_hanmaeum_dinner_attendance": {
      ".read": true,
      "responses": {
        "$memberId": {
          ".write": "$memberId.matches(/^(hq_(0[1-9]|1[0-4])|ops_0[1-9]|maint_0[1-8]|support_0[1-7]|security_0[1-6]|chaplain_0[1-3]|association_0[1-4])$/) && newData.exists()",
          ".validate": "newData.hasChildren(['choice', 'headcount', 'updatedAt'])",
          "choice": {
            ".validate": "newData.val() == 'personal' || newData.val() == 'couple' || newData.val() == 'unavailable'"
          },
          "headcount": {
            ".validate": "newData.isNumber() && ((newData.parent().child('choice').val() == 'personal' && newData.val() == 1) || (newData.parent().child('choice').val() == 'couple' && newData.val() == 2) || (newData.parent().child('choice').val() == 'unavailable' && newData.val() == 0))"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
